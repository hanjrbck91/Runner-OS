{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@runner-os/core": ["packages/core/src/index.ts"],
      "@runner-os/core/adapters/memory": ["packages/core/src/adapters/memory/index.ts"],
      "@runner-os/shared": ["packages/shared/src/index.ts"],
      "@runner-os/database": ["packages/database/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "apps/web/src/server/**/*.ts"]
}
