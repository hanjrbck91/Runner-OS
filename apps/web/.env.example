# Runner OS web (M07-D) — copy to .env.local and fill in. NEVER commit real values.

# PostgreSQL connection (Neon in production). Example:
#   postgres://user:password@host/db?sslmode=require
DATABASE_URL=

# Auth.js session signing secret. Generate: `openssl rand -base64 32`
AUTH_SECRET=

# V1 single-user allowlist: only this email may sign in.
AUTH_ALLOWED_EMAIL=

# Server timezone used to derive "today". Defaults to Asia/Kolkata if unset.
USER_TIMEZONE=Asia/Kolkata

# Email (magic-link) transport for Auth.js Nodemailer provider.
#   EMAIL_SERVER=smtp://user:pass@smtp.host:587
EMAIL_SERVER=
EMAIL_FROM=

# Google OAuth (second sign-in option). Create a Google Cloud OAuth 2.0 Client
# (type: Web application). Authorized redirect URI:
#   https://<your-domain>/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (local dev)
# GOOGLE_CLIENT_SECRET is a secret — server-side only, never commit.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
